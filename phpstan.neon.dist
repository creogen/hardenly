# WordPress functions and classes come from szepeviktor/phpstan-wordpress,
# loaded by phpstan/extension-installer.
parameters:
	level: 6
	phpVersion: 70400
	paths:
		- hardenly.php
		- uninstall.php
		- src
		- tests
	excludePaths:
		- tests/fixtures/*/assets/build/*
		# Stand-ins for WordPress functions and classes that phpstan-wordpress already knows.
		- tests/stubs/*
